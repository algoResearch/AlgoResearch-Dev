# Django
DJANGO_SETTINGS_MODULE=algoresearch.settings.dev
DEBUG=True

# Fastest dev loop (no infra)
USE_INMEMORY_CHANNELS=1
CELERY_EAGER=1

# Optional: local Postgres (no Docker)
# DEV_DATABASE_URL=postgres://<your-username>@127.0.0.1:5432/algoresearch_dev

# Optional: Docker/Codespaces Postgres
# DEV_DATABASE_URL=postgres://postgres:postgres@postgres:5432/postgres

# Optional: Redis when you turn off in-memory channels
# LOCAL_REDIS_URL=redis://redis:6379/0

# Dev-only secrets (safe placeholders)
DJANGO_SECRET_KEY=dev-only-secret
FERNET_KEY=dev-only-fernet-key