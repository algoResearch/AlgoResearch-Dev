# Reference only. Run python3 scripts/init_local_env.py to generate valid local keys.
DJANGO_SETTINGS_MODULE=algoresearch.settings.dev
DEBUG=True
DJANGO_SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_SECRET
FERNET_KEY=REPLACE_WITH_A_NEW_FERNET_KEY
USE_INMEMORY_CHANNELS=1
CELERY_EAGER=1

# Required for native development: create your own local PostgreSQL database.
# Docker Compose overrides these URLs with its isolated local services.
# DEV_DATABASE_URL=postgres://YOUR_LOCAL_USER:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/algoresearch_local
# LOCAL_REDIS_URL=redis://127.0.0.1:6379/0

# Optional integrations require your own credentials. Do not copy production settings.
